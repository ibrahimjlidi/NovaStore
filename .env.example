# Copy to .env.local for local development. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional direct, non-pooled PostgreSQL URL used for migrations.
DATABASE_URL_UNPOOLED=
AUTH_SECRET=generate-a-unique-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
STORE_NAME=NovaStore
STORE_CITY=Tunis
APP_URL=http://localhost:5173
API_PORT=3001

# Optional: enables invitation and self-service password reset emails.
RESEND_API_KEY=
EMAIL_FROM=NovaStore <accounts@example.com>
